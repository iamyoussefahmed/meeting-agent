# Copy to .env and fill in. Never commit .env.

# Attendee (self-hosted). Create the API key in the dashboard at http://localhost:8000
ATTENDEE_URL=http://localhost:8000
ATTENDEE_API_KEY=

# Name shown for the bot in the meeting, and the name the notes are written for
BOT_NAME=Jane's Notetaker
OWNER_NAME=Jane

# Claude API key for summaries (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Gmail account that SENDS the notes, plus its App Password from
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# This can be your own Gmail or a dedicated bot Gmail.
GMAIL_BOT_ADDRESS=
GMAIL_APP_PASSWORD=

# Bot's Google Calendar > Settings > (calendar) > Integrate calendar >
# "Secret address in iCal format". Keep it private: anyone with it can read the calendar.
BOT_CALENDAR_ICS_URL=
# The bot address people add to invites (defaults to GMAIL_BOT_ADDRESS)
BOT_CALENDAR_EMAIL=

# Where the notes go. EMAIL_TO always gets them; invitees whose address is on
# one of COMPANY_DOMAINS (comma-separated) get the same email. Nobody else does.
EMAIL_TO=
COMPANY_DOMAINS=example.com

# The ElevenLabs key is NOT set here: add it in the Attendee dashboard under
# Settings > Credentials, since Attendee calls ElevenLabs itself.
